{
    "ModName": "Body and Clothing Morph",
    "SchemaVersion": 1,
    "Tabs": [
        {
            "TabId": "general",
            "TabName": "General",
            "Sections": [
                {
                    "SectionId": "body_replacement",
                    "SectionName": "Body replacement",
                    "SectionDescription": "Pick the body shape for your currently controlled character. Armor and clothing are refitted automatically; the choice is stored per character in your savegame.",
                    "Settings": [
                        {
                            "Id": "body_choice",
                            "Name": "Body shape",
                            "Type": "radio",
                            "Default": "Vanilla",
                            "Options": {
                                "Choices": [
                                    "Vanilla",
                                    "SBBF",
                                    "BCB",
                                    "External / Pass-through"
                                ]
                            },
                            "Description": "Applies to your currently controlled character. Vanilla, SBBF, and BCB are managed by ClothMorph. External / Pass-through restores ClothMorph's captured original body and equipment routing, preserves other mods' visual/status/item state, and stops ClothMorph changes for that character. Current Vanilla is not pass-through."
                        },
                        {
                            "Id": "apply_on_load",
                            "Name": "Re-apply on save load",
                            "Type": "checkbox",
                            "Default": false,
                            "Description": "If enabled, the body shape above is re-applied to your controlled character every time a save finishes loading. Leave OFF to let each save keep its own per-character choices."
                        },
                        {
                            "Id": "master_enabled",
                            "Name": "Enable ClothMorph mutations",
                            "Type": "checkbox",
                            "Default": true,
                            "Description": "When OFF, restores every currently managed character in this save and suspends all ClothMorph body, clothing, tattoo, and equipment-refresh writes. Choices are preserved and resume when re-enabled; characters individually set to External remain External."
                        },
                        {
                            "Id": "body_tattoo_policy",
                            "Name": "SBBF/BCB body tattoos",
                            "Type": "radio",
                            "Default": "Match Vanilla",
                            "Options": {
                                "Choices": [
                                    "Match Vanilla",
                                    "Hide on SBBF/BCB"
                                ]
                            },
                            "Description": "Controls naked SBBF/BCB bodies for the supported HUM_F family. It leaves Vanilla and your saved tattoo choice untouched. Match Vanilla is the default."
                        }
                    ]
                },
                {
                    "SectionId": "hotkeys",
                    "SectionName": "Hotkeys",
                    "SectionDescription": "Optional hotkeys. They act on your currently controlled character, exactly like the Body shape picker above. All are UNBOUND by default - assign a key here if you want them.",
                    "Settings": [
                        {
                            "Id": "key_cycle_body",
                            "Name": "Cycle body (Vanilla > SBBF > BCB)",
                            "Type": "keybinding_v2",
                            "Default": {
                                "Keyboard": {
                                    "Key": "NONE",
                                    "ModifierKeys": []
                                }
                            },
                            "Options": {
                                "ShouldTriggerOnKeyDown": true,
                                "ShouldTriggerOnKeyUp": false,
                                "ShouldTriggerOnRepeat": false,
                                "BlockIfLevelNotStarted": true
                            },
                            "Description": "Cycles the controlled character's body shape: Vanilla -> SBBF -> BCB -> Vanilla."
                        },
                        {
                            "Id": "key_set_vanilla",
                            "Name": "Set body: Vanilla",
                            "Type": "keybinding_v2",
                            "Default": {
                                "Keyboard": {
                                    "Key": "NONE",
                                    "ModifierKeys": []
                                }
                            },
                            "Options": {
                                "ShouldTriggerOnKeyDown": true,
                                "ShouldTriggerOnKeyUp": false,
                                "ShouldTriggerOnRepeat": false,
                                "BlockIfLevelNotStarted": true
                            },
                            "Description": "Sets the controlled character's body to Vanilla."
                        },
                        {
                            "Id": "key_set_sbbf",
                            "Name": "Set body: SBBF",
                            "Type": "keybinding_v2",
                            "Default": {
                                "Keyboard": {
                                    "Key": "NONE",
                                    "ModifierKeys": []
                                }
                            },
                            "Options": {
                                "ShouldTriggerOnKeyDown": true,
                                "ShouldTriggerOnKeyUp": false,
                                "ShouldTriggerOnRepeat": false,
                                "BlockIfLevelNotStarted": true
                            },
                            "Description": "Sets the controlled character's body to SBBF."
                        },
                        {
                            "Id": "key_set_bcb",
                            "Name": "Set body: BCB",
                            "Type": "keybinding_v2",
                            "Default": {
                                "Keyboard": {
                                    "Key": "NONE",
                                    "ModifierKeys": []
                                }
                            },
                            "Options": {
                                "ShouldTriggerOnKeyDown": true,
                                "ShouldTriggerOnKeyUp": false,
                                "ShouldTriggerOnRepeat": false,
                                "BlockIfLevelNotStarted": true
                            },
                            "Description": "Sets the controlled character's body to BCB."
                        },
                        {
                            "Id": "key_set_external",
                            "Name": "Set body ownership: External / Pass-through",
                            "Type": "keybinding_v2",
                            "Default": {
                                "Keyboard": {
                                    "Key": "NONE",
                                    "ModifierKeys": []
                                }
                            },
                            "Options": {
                                "ShouldTriggerOnKeyDown": true,
                                "ShouldTriggerOnKeyUp": false,
                                "ShouldTriggerOnRepeat": false,
                                "BlockIfLevelNotStarted": true
                            },
                            "Description": "Release ClothMorph ownership for the currently controlled character."
                        }
                    ]
                }
            ]
        }
    ]
}
